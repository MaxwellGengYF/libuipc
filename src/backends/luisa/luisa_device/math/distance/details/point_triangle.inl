template <typename T>
void point_triangle_distance2(const LVec<T, 3>& p,
                              const LVec<T, 3>& t0,
                              const LVec<T, 3>& t1,
                              const LVec<T, 3>& t2,
                              T&                dist2)
{
    // b = (t1 - t0).cross(t2 - t0); dist2 = ((p - t0).dot(b))^2 / b.squaredNorm()
    auto b   = math::cross(t1 - t0, t2 - t0);
    auto aTb = math::dot(p - t0, b);
    dist2    = math::detail::div(math::detail::mul(aTb, aTb), math::squaredNorm(b));
}

template <typename T>
void point_triangle_distance2_gradient(const LVec<T, 3>& p,
                                       const LVec<T, 3>& t0,
