                                       LVec<T, 12>&      grad)
{
    details::g_PT(p(0),
                  p(1),
                  p(2),
                  t0(0),
                  t0(1),
                  t0(2),
                  t1(0),
                  t1(1),
                  t1(2),
                  t2(0),
                  t2(1),
                  t2(2),
                  grad.data.data());
}

