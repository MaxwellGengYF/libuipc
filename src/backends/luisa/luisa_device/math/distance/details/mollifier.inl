/// `e = (-input/eps_x + 2) * input/eps_x` — the reference's `EEM`.
template <typename T>
inline void EEM(const T& input, const T& eps_x, T& e)
{
    auto input_div_eps_x = div(input, eps_x);
    e                    = mul(add(neg(input_div_eps_x), 2.0), input_div_eps_x);
}

/// Derivative of `EEM` w.r.t. `input` — the reference's `g_EEM`.
template <typename T>
inline void g_EEM(const T& input, const T& eps_x, T& g)
{
    auto one_div_eps_x = div(1.0, eps_x);
    g = mul(mul(2.0, one_div_eps_x), add(neg(mul(one_div_eps_x, input)), 1.0));
}

/// Second derivative of `EEM` w.r.t. `input` — the reference's `H_EEM`.
template <typename T>
inline void H_EEM(const T& input, const T& eps_x, T& H)
{
    (void)input;  // the reference's closed form does not use it
    H = div(neg(2.0), mul(eps_x, eps_x));
}
}  // namespace details

template <typename T>
void edge_edge_cross_norm2(const LVec<T, 3>& ea0,
                           const LVec<T, 3>& ea1,
                           const LVec<T, 3>& eb0,
                           const LVec<T, 3>& eb1,
                           T&                result)
{
    // (ea1 - ea0).cross(eb1 - eb0).squaredNorm()
    auto c = math::cross(ea1 - ea0, eb1 - eb0);
    result = math::squaredNorm(c);
}

template <typename T>
void edge_edge_cross_norm2_gradient(const LVec<T, 3>& ea0,
                                    const LVec<T, 3>& ea1,
                                    const LVec<T, 3>& eb0,
                                    const LVec<T, 3>& eb1,
                                    LVec<T, 12>&      grad)
{
    details::g_EECN2(ea0(0),
                     ea0(1),
                     ea0(2),
                     ea1(0),
                     ea1(1),
                     ea1(2),
                     eb0(0),
                     eb0(1),
                     eb0(2),
                     eb1(0),
                     eb1(1),
                     eb1(2),
                     grad.data.data());
}

template <typename T>
void edge_edge_cross_norm2_hessian(const LVec<T, 3>& ea0,
                                   const LVec<T, 3>& ea1,
                                   const LVec<T, 3>& eb0,
                                   const LVec<T, 3>& eb1,
                                   LMat<T, 12, 12>&  Hessian)
{
    details::H_EECN2(ea0(0),
                     ea0(1),
                     ea0(2),
                     ea1(0),
                     ea1(1),
                     ea1(2),
                     eb0(0),
                     eb0(1),
                     eb0(2),
                     eb1(0),
                     eb1(1),
                     eb1(2),
                     Hessian.data.data());
}

/// Whether the current configuration is inside the mollified (near-parallel)
/// region.  NOTE: this is the host-side (`double`) flavour; the device flavour
/// below returns a DSL boolean instead of a host `bool` (RULE M2 — a device
/// predicate cannot be a `bool`).
template <typename T>
    requires std::is_arithmetic_v<T>
bool need_mollify(const LVec<T, 3>& ea0,
                  const LVec<T, 3>& ea1,
                  const LVec<T, 3>& eb0,
                  const LVec<T, 3>& eb1,
                  T                 eps_x)
{
    T EECrossSqNorm;
    edge_edge_cross_norm2(ea0, ea1, eb0, eb1, EECrossSqNorm);
    return EECrossSqNorm < eps_x;
}

/// Device flavour: the predicate is a device value, so it is returned as one.
/// (Declared next to the pinned host overload in `mollifier.h`.)
template <typename T>
    requires(!std::is_arithmetic_v<T>)
bool_of_t<T> need_mollify(const LVec<T, 3>& ea0,
                          const LVec<T, 3>& ea1,
                          const LVec<T, 3>& eb0,
                          const LVec<T, 3>& eb1,
                          T                 eps_x)
{
    T EECrossSqNorm;
    edge_edge_cross_norm2(ea0, ea1, eb0, eb1, EECrossSqNorm);
    return EECrossSqNorm < eps_x;
}

template <typename T>
void edge_edge_mollifier(const LVec<T, 3>& ea0,
                         const LVec<T, 3>& ea1,
                         const LVec<T, 3>& eb0,
                         const LVec<T, 3>& eb1,
                         T                 eps_x,
                         T&                e)
{
    T EECrossSqNorm;
    edge_edge_cross_norm2(ea0, ea1, eb0, eb1, EECrossSqNorm);

    // if(EECrossSqNorm < eps_x) e = EEM(...) else e = 1.0 — predicated.
    T e_mollified;
    details::EEM(EECrossSqNorm, eps_x, e_mollified);
    e = detail::select_scalar(math::make_scalar<T>(1.0),
                      e_mollified,
                      /*predicate=*/EECrossSqNorm < eps_x);
}

template <typename T>
void edge_edge_mollifier_gradient(const LVec<T, 3>& ea0,
                                  const LVec<T, 3>& ea1,
                                  const LVec<T, 3>& eb0,
                                  const LVec<T, 3>& eb1,
                                  T                 eps_x,
                                  LVec<T, 12>&      g)
{
    T EECrossSqNorm;
    edge_edge_cross_norm2(ea0, ea1, eb0, eb1, EECrossSqNorm);
    auto pred = EECrossSqNorm < eps_x;

    // if(pred) { g = g_EEM * d(EECrossSqNorm) } else { g.setZero() } — predicated.
    T           q_g;
    LVec<T, 12> g_candidate;
    details::g_EEM(EECrossSqNorm, eps_x, q_g);
    edge_edge_cross_norm2_gradient(ea0, ea1, eb0, eb1, g_candidate);

    // element-wise: `select` must never see an LVec (cookbook §7.6 trap #3)
    g = math::make_vec<T, 12>([&](int i) noexcept
                              {
                                  return detail::select_scalar(zero_of<T>(),
                                                       math::detail::mul(q_g, g_candidate(i)),
                                                       pred);
                              });
}

template <typename T>
void edge_edge_mollifier_hessian(const LVec<T, 3>& ea0,
                                 const LVec<T, 3>& ea1,
                                 const LVec<T, 3>& eb0,
                                 const LVec<T, 3>& eb1,
                                 T                 eps_x,
                                 LMat<T, 12, 12>&  H)
{
    T EECrossSqNorm;
    edge_edge_cross_norm2(ea0, ea1, eb0, eb1, EECrossSqNorm);
    auto pred = EECrossSqNorm < eps_x;

    // if(pred) { H = q_g * d2(ECSN) + q_H * d(ECSN) d(ECSN)^T } else { H.setZero() }
    T             q_g, q_H;
    LVec<T, 12>   g_candidate;
    LMat<T, 12, 12> H_candidate;
    details::g_EEM(EECrossSqNorm, eps_x, q_g);
    details::H_EEM(EECrossSqNorm, eps_x, q_H);
    edge_edge_cross_norm2_gradient(ea0, ea1, eb0, eb1, g_candidate);
    edge_edge_cross_norm2_hessian(ea0, ea1, eb0, eb1, H_candidate);

    H_candidate *= q_g;
    H_candidate += (q_H * g_candidate) * g_candidate.transpose();

    H = math::make_mat<T, 12, 12>([&](int r, int c) noexcept
                                  { return detail::select_scalar(zero_of<T>(), H_candidate(r, c), pred); });
}

template <typename T>
void edge_edge_mollifier_threshold(const LVec<T, 3>& ea0_rest,
                                   const LVec<T, 3>& ea1_rest,
                                   const LVec<T, 3>& eb0_rest,
                                   const LVec<T, 3>& eb1_rest,
                                   double            coeff,
                                   T&                eps_x)
{
    // coeff * |ea0_rest - ea1_rest|^2 * |eb0_rest - eb1_rest|^2
    eps_x = math::detail::mul(
        math::detail::mul(coeff, math::squaredNorm(ea0_rest - ea1_rest)),
        math::squaredNorm(eb0_rest - eb1_rest));
}
