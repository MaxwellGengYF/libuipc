void point_edge_distance2_hessian(const LVec<T, 3>& p,
                                  const LVec<T, 3>& e0,
                                  const LVec<T, 3>& e1,
                                  LMat<T, 9, 9>&    Hessian)
{
    details::H_PE3D(
        p(0), p(1), p(2), e0(0), e0(1), e0(2), e1(0), e1(1), e1(2), Hessian.data.data());
}
