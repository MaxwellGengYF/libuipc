template <typename T>
void point_edge_distance2(const LVec<T, 3>& p,
                          const LVec<T, 3>& e0,
                          const LVec<T, 3>& e1,
                          T&                dist2)
{
    // (e0 - p).cross(e1 - p).squaredNorm() / (e1 - e0).squaredNorm()
    auto c = math::cross(e0 - p, e1 - p);
    auto d = e1 - e0;
    dist2  = math::detail::div(math::squaredNorm(c), math::squaredNorm(d));
}

template <typename T>
void point_edge_distance2_gradient(const LVec<T, 3>& p,
                                   const LVec<T, 3>& e0,
                                   const LVec<T, 3>& e1,
                                   LVec<T, 9>&       grad)
{
    details::g_PE3D(
        p(0), p(1), p(2), e0(0), e0(1), e0(2), e1(0), e1(1), e1(2), grad.data.data());
}

